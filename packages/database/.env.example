# En local, SIEMPRE la rama `develop` de Neon (nunca producción).
# Pooled (host con -pooler): la usa Prisma Client.
DATABASE_URL=postgresql://user:password@host-pooler:5432/agrodata?sslmode=require
# Directa (host sin -pooler): la usan las migraciones (`db:migrate`, `db:migrate:deploy`).
DIRECT_URL=postgresql://user:password@host:5432/agrodata?sslmode=require
