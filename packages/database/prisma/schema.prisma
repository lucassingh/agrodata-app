generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum PlatformRole {
  OWNER
  FARM_MANAGER
  OPERATOR
}

enum SystemRole {
  ADMIN
  USER_GENERAL
}

enum ProfileType {
  AGRONOMO
  VETERINARIO
  PRODUCTOR
  ADMINISTRATIVO
  OTRO
}

enum TenantCategory {
  FIELD_AGRICOLA
  GANADERO
  TAMBO
  MIXTO
}

enum MembershipStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum RecordType {
  SEEDING
  ANIMAL_BIRTH
  POTRERO_CHANGE
  PURCHASE
  SALE
  FUMIGATION
  FUEL_USAGE
  EXPENSE_INVOICE
  TASK_COMPLETED
  SANITARY_TREATMENT
  ANIMAL_DEATH
  FERTILIZATION
  HARVEST
  WEIGHING
  REPRODUCTION
  MILK_PRODUCTION
  MILK_SETTLEMENT
}

enum TaskType {
  TRATAMIENTO_SANITARIO
  ORDEN_SIEMBRA
  PULVERIZACION
  FERTILIZACION
}

enum TaskStatus {
  PENDING
  COMPLETED
}

enum SupplyCategoryType {
  ALIMENTO
  SANIDAD
  INSUMOS_AGRICOLAS
  FERTILIZANTES
}

enum CurrencyType {
  ARS
  USD
}

// ─── Tenant ──────────────────────────────────────────────

model Tenant {
  id           String               @id @default(cuid())
  name         String
  timezone     String               @default("America/Argentina/Buenos_Aires")
  baseCurrency String               @default("ARS")
  /// Dólar con el que este campo convierte sus márgenes (Preferencias).
  exchangeRateKind ExchangeRateKind @default(MAYORISTA)
  /// Condición frente al IVA: define si los márgenes cuentan los costos con o sin IVA.
  vatCondition     VatCondition     @default(RESPONSABLE_INSCRIPTO)
  category     TenantCategory       @default(MIXTO)
  location     String?
  totalHa      Float?
  mapFileUrl   String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  memberships       UserTenantMembership[]
  pendingInvites    TenantPendingInvite[]
  records           Record[]
  pastures          Pasture[]
  tasks             Task[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]
  supplies          Supply[]
  supplyCategories  SupplyCategory[]
  animalCategories  AnimalCategory[]
  rodeos            Rodeo[]
  cropConfigs       CropConfig[]
  supplyConfigs     SupplyConfig[]
  expenseConfigs    ExpenseConfig[]
  pendingWhatsAppActions PendingWhatsAppAction[]
  livestockEvents   LivestockEvent[]
  stockMovements    StockMovement[]
  campaigns         Campaign[]
  costAllocations   CostAllocation[]
  harvests          Harvest[]
  incomes           Income[]
  weighings         Weighing[]
  reproEvents       ReproEvent[]
  milkRecords       MilkRecord[]
  milkSettlements   MilkSettlement[]

  @@map("tenants")
}

// ─── User ────────────────────────────────────────────────

model User {
  id             String               @id @default(cuid())
  name           String
  lastname       String
  email          String?              @unique
  wNumber        String?              @unique
  passwordHash   String?
  profileType    ProfileType          @default(OTRO)
  /// Acceso global a la plataforma (configuración, soporte, etc.)
  isSuperAdmin   Boolean              @default(false)
  platformRole   PlatformRole         @default(OPERATOR)
  status         UserStatus           @default(ACTIVE)
  activeTenantId String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  memberships           UserTenantMembership[]
  verificationCodes     VerificationCode[]
  assignedTasks         Task[]                 @relation("TaskResponsible")
  tenantInvitesCreated  TenantPendingInvite[] @relation("TenantInviteInvitedBy")
  pendingWhatsAppActions PendingWhatsAppAction[]

  @@map("users")
}

/// Invitación a un campo antes de que exista el usuario (mismo email o WhatsApp al registrarse).
model TenantPendingInvite {
  id              String    @id @default(cuid())
  tenantId        String
  role            SystemRole
  invitedByUserId String
  email           String?
  wNumber         String?
  createdAt       DateTime  @default(now())
  consumedAt      DateTime?
  consumedUserId  String?

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy User   @relation("TenantInviteInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([email])
  @@index([wNumber])
  @@map("tenant_pending_invites")
}

model VerificationCode {
  id        String   @id @default(cuid())
  userId    String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, code])
  @@map("verification_codes")
}

// ─── Membership ──────────────────────────────────────────

model UserTenantMembership {
  id         String           @id @default(cuid())
  userId     String
  tenantId   String
  role       SystemRole
  status     MembershipStatus @default(INVITED)
  specialty  String?
  invitedAt  DateTime         @default(now())
  acceptedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId, role])
  @@map("user_tenant_memberships")
}

// ─── Records ─────────────────────────────────────────────

model Record {
  id         String     @id @default(cuid())
  tenantId   String
  type       RecordType
  occurredAt DateTime
  data       Json
  source     String
  confidence Float?
  rawMessage String?
  userId     String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, type, occurredAt])
  @@map("records")
}

// ─── Pastures (Potreros) ─────────────────────────────────

model Pasture {
  id       String @id @default(cuid())
  tenantId String
  name     String
  hectares Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  crops   PastureCrop[]
  animals PastureAnimal[]
  taskPastures TaskPasture[]
  livestockEvents LivestockEvent[]
  stockMovements  StockMovement[]
  campaigns       Campaign[]
  weighings       Weighing[]

  @@index([tenantId])
  @@map("pastures")
}

model PastureCrop {
  id        String    @id @default(cuid())
  pastureId String
  crop      String
  hectares  Float?
  startDate DateTime?

  pasture Pasture @relation(fields: [pastureId], references: [id], onDelete: Cascade)

  @@map("pasture_crops")
}

model PastureAnimal {
  id            String  @id @default(cuid())
  pastureId     String
  quantity      Int
  animalType    String
  averageWeight Float?

  pasture Pasture @relation(fields: [pastureId], references: [id], onDelete: Cascade)

  @@map("pasture_animals")
}

// ─── Tasks (Tareas) ──────────────────────────────────────

model Task {
  id            String     @id @default(cuid())
  tenantId      String
  type          TaskType
  status        TaskStatus @default(PENDING)
  deadline      DateTime
  treatment     String?
  crop          String?
  genetic       String?
  spacing       String?
  density       String?
  densityUnit   String?
  contractor    String?
  description   String?
  responsibleId String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  responsible User?           @relation("TaskResponsible", fields: [responsibleId], references: [id])
  products    TaskProduct[]
  pastures    TaskPasture[]
  animals     TaskAnimal[]
  fertilizers TaskFertilizer[]

  @@index([tenantId, status])
  @@index([tenantId, type])
  @@map("tasks")
}

model TaskProduct {
  id          String  @id @default(cuid())
  taskId      String
  productName String
  dosis       String?
  unit        String?

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_products")
}

model TaskPasture {
  id        String  @id @default(cuid())
  taskId    String
  pastureId String
  hectares  String?

  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  pasture Pasture @relation(fields: [pastureId], references: [id], onDelete: Cascade)

  @@map("task_pastures")
}

model TaskAnimal {
  id         String @id @default(cuid())
  taskId     String
  quantity   Int
  animalType String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_animals")
}

model TaskFertilizer {
  id     String  @id @default(cuid())
  taskId String
  source String
  dosis  String?
  unit   String?

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_fertilizers")
}

// ─── Expenses (Gastos) ───────────────────────────────────

model ExpenseCategory {
  id       String @id @default(cuid())
  tenantId String
  name     String
  color    String @default("#3F8C3C")
  createdAt DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([tenantId, name])
  @@map("expense_categories")
}

model Expense {
  id          String       @id @default(cuid())
  tenantId    String
  categoryId  String
  amount      Float
  currency    CurrencyType @default(ARS)
  date        DateTime
  description String?
  withIva     Boolean      @default(true)
  /// Tipo de cambio de la factura, si lo trae (manda sobre la cotización del día).
  exchangeRate Float?
  /// Alícuota de IVA del gasto (0.21, 0.105, 0.27, 0 = exento). Null: la sugerida por la categoría.
  vatRate     Float?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category    ExpenseCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  allocations CostAllocation[]

  @@index([tenantId, date])
  @@map("expenses")
}

// ─── Supplies (Insumos) ──────────────────────────────────

model SupplyCategory {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  code      String?
  color     String?
  createdAt DateTime @default(now())

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplies Supply[]
  configs  SupplyConfig[]

  @@unique([tenantId, name])
  @@map("supply_categories")
}

model Supply {
  id          String   @id @default(cuid())
  tenantId    String
  categoryId  String
  name        String
  quantity    Float    @default(0)
  unit        String?
  cost        Float?
  currency    CurrencyType @default(ARS)
  supplier    String?
  /// Alícuota de IVA de sus compras (el costo se guarda sin IVA).
  vatRate     Float?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category SupplyCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  movements StockMovement[]

  @@index([tenantId, categoryId])
  @@map("supplies")
}

// ─── Preferences / Config ────────────────────────────────

model AnimalCategory {
  id       String @id @default(cuid())
  tenantId String
  name     String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@map("animal_categories")
}

model Rodeo {
  id       String @id @default(cuid())
  tenantId String
  name     String
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  weighings   Weighing[]
  reproEvents ReproEvent[]

  @@unique([tenantId, name])
  @@map("rodeos")
}

model CropConfig {
  id       String @id @default(cuid())
  tenantId String
  name     String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@map("crop_configs")
}

model SupplyConfig {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  categoryId String
  createdAt  DateTime @default(now())

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category SupplyCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([tenantId, name])
  @@map("supply_configs")
}

model ExpenseConfig {
  id       String @id @default(cuid())
  tenantId String
  name     String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@map("expense_configs")
}

// ─── Webhook Events ──────────────────────────────────────

model WebhookEvent {
  id         String   @id @default(cuid())
  channel    String
  eventType  String
  tenantId   String?
  /// ID único del proveedor (ej. wamid de WhatsApp) para deduplicar reintentos
  /// de entrega a nivel de constraint de DB -- evita la condición de carrera
  /// de un "buscar y después insertar" bajo entregas concurrentes.
  externalId String?  @unique
  payload    Json
  createdAt  DateTime @default(now())

  @@index([channel, createdAt])
  @@map("webhook_events")
}

// ─── WhatsApp: acción pendiente de confirmación ──────────
// Un mensaje de WhatsApp que necesita una respuesta del productor antes de
// completarse (ej. "no tenés la categoría X, ¿la creo?") guarda acá lo que ya
// extrajo Claude. `waId` es único: un número tiene como máximo UNA acción
// pendiente; una nueva reemplaza a la anterior. Vence a las 24 hs (se descarta
// al leerla, sin cron). Ver el plan de la Slice C de la Fase 4.
model PendingWhatsAppAction {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String
  waId       String   @unique
  actionType String
  payload    Json
  question   String
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("pending_whatsapp_actions")
}

// ─── Hacienda: movimientos ───────────────────────────────
// Cada entrada o salida de animales de un potrero (nacimiento, compra, venta,
// mortandad, traslado). `PastureAnimal` guarda el stock actual; esta tabla
// guarda la historia: KPI de mortandad, historial de potreros y, más adelante,
// ingresos por venta de hacienda. Los montos y kilos de una venta o compra se
// guardan acá aunque todavía no exista el módulo de ingresos.
enum LivestockEventType {
  BIRTH
  PURCHASE
  SALE
  DEATH
  TRANSFER_IN
  TRANSFER_OUT
  // Correcciones hechas a mano en Potreros (alta o baja sin un evento de campo detrás).
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

model LivestockEvent {
  id           String             @id @default(cuid())
  tenantId     String
  pastureId    String?
  type         LivestockEventType
  animalType   String
  quantity     Int
  date         DateTime
  totalKg      Float?
  amount       Float?
  currency     CurrencyType?
  counterparty String?
  recordId     String?
  createdAt    DateTime           @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pasture Pasture? @relation(fields: [pastureId], references: [id], onDelete: SetNull)

  @@index([tenantId, type, date])
  @@map("livestock_events")
}

// Cada cambio de stock de un insumo: de dónde vino, cuánto, a qué costo y cómo
// quedó el saldo. `quantity` es lo que realmente se movió (un consumo mayor al
// stock se registra por lo que había). Base del costo de lo aplicado por lote.
enum StockDirection {
  IN
  OUT
}

enum StockMovementSource {
  INITIAL
  MANUAL
  EDIT
  WHATSAPP
}

model StockMovement {
  id        String              @id @default(cuid())
  tenantId  String
  supplyId  String
  direction StockDirection
  quantity  Float
  balance   Float
  unitCost  Float?
  currency  CurrencyType?
  source    StockMovementSource
  pastureId String?
  recordId  String?
  userId    String?
  date      DateTime            @default(now())
  createdAt DateTime            @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supply  Supply   @relation(fields: [supplyId], references: [id], onDelete: Cascade)
  pasture Pasture? @relation(fields: [pastureId], references: [id], onDelete: SetNull)
  allocations CostAllocation[]

  @@index([supplyId, date])
  @@index([tenantId, date])
  @@map("stock_movements")
}

// ─── Economía por lote (Etapa 2) ─────────────────────────

// Cotizaciones del dólar por día y tipo (dolarapi.com / argentinadatos.com).
// Globales, no por campo: la cotización es la misma para todos.
enum ExchangeRateKind {
  MAYORISTA
  OFICIAL
  BLUE
  BOLSA
  CONTADOCONLIQUI
  CRIPTO
  TARJETA
}

model ExchangeRate {
  id        String           @id @default(cuid())
  kind      ExchangeRateKind
  date      DateTime         @db.Date
  buy       Float
  sell      Float
  source    String
  updatedAt DateTime         @updatedAt

  @@unique([kind, date])
  @@map("exchange_rates")
}

// Campaña = cultivo × lote × ciclo agrícola (julio a junio: "26/27").
enum CampaignStatus {
  IN_PROGRESS
  HARVESTED
  CLOSED
}

model Campaign {
  id             String         @id @default(cuid())
  tenantId       String
  pastureId      String
  crop           String
  season         String
  hectares       Float?
  sowingDate     DateTime?
  status         CampaignStatus @default(IN_PROGRESS)
  /// Precio de referencia en USD por tonelada, para estimar el margen antes de vender.
  referencePrice Float?
  notes          String?
  recordId       String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pasture     Pasture          @relation(fields: [pastureId], references: [id], onDelete: Cascade)
  allocations CostAllocation[]
  harvests    Harvest[]
  incomes     Income[]

  @@index([tenantId, season])
  @@index([pastureId, status])
  @@map("campaigns")
}

// Qué parte de un gasto o de un consumo de stock es costo directo de una campaña.
// Un gasto de varios lotes se reparte en varias filas (por hectáreas).
model CostAllocation {
  id              String       @id @default(cuid())
  tenantId        String
  campaignId      String
  expenseId       String?
  stockMovementId String?
  /// Monto sin IVA.
  amount          Float
  currency        CurrencyType
  /// Alícuota que corresponde a ese costo (para sumarla si el campo es monotributista).
  vatRate         Float?
  date            DateTime
  concept         String
  createdAt       DateTime     @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign      Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  expense       Expense?       @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  stockMovement StockMovement? @relation(fields: [stockMovementId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([expenseId])
  @@index([stockMovementId])
  @@map("cost_allocations")
}

model Harvest {
  id         String   @id @default(cuid())
  tenantId   String
  campaignId String
  date       DateTime
  totalKg    Float
  moisture   Float?
  recordId   String?
  createdAt  DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("harvests")
}

enum IncomeType {
  GRAIN_SALE
  OTHER
}

model Income {
  id           String       @id @default(cuid())
  tenantId     String
  campaignId   String?
  type         IncomeType
  date         DateTime
  crop         String?
  quantityKg   Float?
  amount       Float
  currency     CurrencyType
  /// Tipo de cambio del comprobante, si lo trae.
  exchangeRate Float?
  counterparty String?
  description  String?
  recordId     String?
  createdAt    DateTime     @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([tenantId, date])
  @@index([campaignId])
  @@map("incomes")
}

enum VatCondition {
  RESPONSABLE_INSCRIPTO
  MONOTRIBUTISTA
}

// ─── Ganadería productiva y tambo (Etapa 3) ──────────────

// Pesada de un grupo: una categoría de animal en un potrero (o corral), con rodeo
// opcional. Se guarda el promedio; de dos pesadas del mismo grupo sale el ADPV.
model Weighing {
  id         String   @id @default(cuid())
  tenantId   String
  pastureId  String?
  animalType String
  rodeoId    String?
  date       DateTime
  headCount  Int
  averageKg  Float
  /// WHATSAPP, WEB o EXCEL.
  source     String
  recordId   String?
  createdAt  DateTime @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pasture Pasture? @relation(fields: [pastureId], references: [id], onDelete: SetNull)
  rodeo   Rodeo?   @relation(fields: [rodeoId], references: [id], onDelete: SetNull)

  @@index([tenantId, pastureId, animalType, date])
  @@map("weighings")
}

// Eventos reproductivos por conteo (no por animal): inicio de servicio (vacas
// entoradas), tacto (preñadas y vacías), partos y destete.
enum ReproEventType {
  SERVICE_START
  PREGNANCY_CHECK
  CALVING
  WEANING
}

model ReproEvent {
  id         String         @id @default(cuid())
  tenantId   String
  rodeoId    String?
  animalType String?
  type       ReproEventType
  date       DateTime
  females    Int?
  pregnant   Int?
  empty      Int?
  births     Int?
  weaned     Int?
  recordId   String?
  createdAt  DateTime       @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rodeo  Rodeo? @relation(fields: [rodeoId], references: [id], onDelete: SetNull)

  @@index([tenantId, date])
  @@map("repro_events")
}

// Producción diaria del tambo: un registro por día (un mensaje nuevo del mismo
// día lo reemplaza).
model MilkRecord {
  id          String   @id @default(cuid())
  tenantId    String
  date        DateTime @db.Date
  liters      Float
  cowsMilking Int?
  cowsDry     Int?
  recordId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
  @@map("milk_records")
}

// Liquidación de la usina por un período.
model MilkSettlement {
  id            String       @id @default(cuid())
  tenantId      String
  periodStart   DateTime     @db.Date
  periodEnd     DateTime     @db.Date
  dairy         String?
  liters        Float
  fatPct        Float?
  proteinPct    Float?
  pricePerLiter Float?
  totalAmount   Float
  currency      CurrencyType @default(ARS)
  recordId      String?
  createdAt     DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, periodEnd])
  @@map("milk_settlements")
}
