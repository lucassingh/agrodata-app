DATABASE_URL=postgresql://user:password@host:5432/agrodata?schema=public
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# WhatsApp Cloud API (Meta for Developers > tu App > WhatsApp > Configuración de la API)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# App Secret de la App de Meta (Configuración > Básica) -- para validar la firma del webhook
WHATSAPP_APP_SECRET=
# String inventado por nosotros, tiene que coincidir con el que se configura en el panel de Meta al suscribir el webhook
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Claude API
ANTHROPIC_API_KEY=

# OpenAI API (transcripción de notas de voz de WhatsApp con gpt-transcribe -- Slice B)
OPENAI_API_KEY=

# Inngest (procesamiento async de mensajes de WhatsApp)
# INNGEST_DEV=1 activa el modo dev del SDK (necesario en local con `npx inngest-cli dev`
# -- sin esto el endpoint /api/inngest tira 500 buscando una signing key de producción).
INNGEST_DEV=1
# EVENT_KEY/SIGNING_KEY vacías en desarrollo local, se completan recién al deployar
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
