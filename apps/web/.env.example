# Base de datos: en local, SIEMPRE la rama `develop` de Neon (nunca producción).
# Pooled (host con -pooler) para la app; directa (sin -pooler) para las migraciones.
DATABASE_URL=postgresql://user:password@host-pooler:5432/agrodata?sslmode=require
DIRECT_URL=postgresql://user:password@host:5432/agrodata?sslmode=require

# Auth.js: un AUTH_SECRET distinto por entorno (local/develop y producción).
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Soporte de la plataforma: emails separados por coma, con todos los permisos en todos los campos.
SUPER_ADMIN_EMAILS=

# Registro: "open" (cualquiera crea su cuenta y arranca la prueba) o "invite" (acceso anticipado:
# solo con un código de acceso que se da desde Soporte o con una invitación de un equipo).
# Vacío: "invite" en producción y "open" en develop y local. La landing se genera en el build:
# después de cambiarlo en Vercel hay que volver a deployar.
SIGNUP_MODE=

# Mercado Pago (Checkout Pro). Access Token de la aplicación: en develop y local, el de
# «Pruebas → Credenciales de prueba» (empieza con APP_USR, igual que el de producción).
MERCADOPAGO_ACCESS_TOKEN=
# Clave secreta de Webhooks (Tus integraciones → Webhooks) para verificar los avisos de pago.
MERCADOPAGO_WEBHOOK_SECRET=
# "true" o "false". Vacío: prendido en develop y local, apagado en producción. Sin token, apagado.
PAYMENTS_ENABLED=

# Emails (Resend): aviso de pedidos de demo al equipo. Sin la clave no se manda nada.
RESEND_API_KEY=
# A quién llega el aviso de cada pedido de demo
DEMO_REQUESTS_EMAIL=
# Remitente. Sin dominio propio verificado en Resend, solo sirve su dirección de prueba (y solo
# le puede escribir al email de la cuenta de Resend).
EMAIL_FROM=AgroData <onboarding@resend.dev>

# WhatsApp Cloud API (Meta for Developers > tu App > WhatsApp > Configuración de la API)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# App Secret de la App de Meta (Configuración > Básica) -- para validar la firma del webhook
WHATSAPP_APP_SECRET=
# String inventado por nosotros, tiene que coincidir con el que se configura en el panel de Meta al suscribir el webhook
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Claude API
ANTHROPIC_API_KEY=

# OpenAI API (transcripción de notas de voz de WhatsApp con gpt-transcribe -- Slice B)
OPENAI_API_KEY=

# Inngest (procesamiento async de mensajes de WhatsApp)
# INNGEST_DEV=1 activa el modo dev del SDK (necesario en local con `npx inngest-cli dev`
# -- sin esto el endpoint /api/inngest tira 500 buscando una signing key de producción).
INNGEST_DEV=1
# EVENT_KEY/SIGNING_KEY vacías en desarrollo local, se completan recién al deployar
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Resumen semanal: plantilla aprobada en Meta para escribir fuera de la ventana de 24 hs.
# Cuerpo con dos variables: {{1}} nombre del campo, {{2}} resumen en una línea.
WHATSAPP_WEEKLY_SUMMARY_TEMPLATE=
# Idioma de la plantilla (por defecto es_AR)
WHATSAPP_WEEKLY_SUMMARY_TEMPLATE_LANG=

# Avisos diarios: plantilla aprobada en Meta para escribir fuera de la ventana de 24 hs.
# Cuerpo con dos variables: {{1}} nombre del campo, {{2}} avisos en una línea.
WHATSAPP_ALERTS_TEMPLATE=
# Idioma de la plantilla (por defecto es_AR)
WHATSAPP_ALERTS_TEMPLATE_LANG=

# Sentry (opcional: sin DSN queda apagado). El DSN no es secreto, va al navegador.
NEXT_PUBLIC_SENTRY_DSN=
# Solo para subir source maps en el build de Vercel
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
